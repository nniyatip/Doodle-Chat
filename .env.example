# Copy this file to .env and restart `npm run dev`.

# Base URL of the Doodle Chat API (https://github.com/DoodleScheduling/frontend-challenge-chat-api)
VITE_API_URL=http://localhost:3000/api/v1

# Bearer token expected by the API. This value is public and hardcoded by the challenge API;
# a real application would obtain a token through an authentication flow instead.
VITE_API_TOKEN=super-secret-doodle-token
